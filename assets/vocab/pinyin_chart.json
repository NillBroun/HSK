  "rules": [
    {
      "title": "j, q, x এর সাথে ü এর নিয়ম",
      "detail": "j, q, x এর সাথে ü বসলে লেখার সময় দুটি ফোঁটা বাদ দিয়ে u লেখা হয় (যেমন ju, qu, xu), কিন্তু উচ্চারণ ü-এর মতোই থাকে।"
    },
    {
      "title": "সব কম্বিনেশন একসাথে হয় না",
      "detail": "Initial আর Final-এর প্রতিটি জোড়া বাস্তব শব্দে ব্যবহৃত হয় না; চার্টে যে কম্বিনেশনগুলো আছে, শুধু সেগুলোই প্রচলিত উচ্চারণ।"
    },
    {
      "title": "টোন বদলালে অর্থ বদলায়",
      "detail": "একই পিনয়িন সিলেবলকে ১ম, ২য়, ৩য় বা ৪র্থ টোনে উচ্চারণ করলে শব্দের অর্থ ভিন্ন হয়ে যায়।"
    }
